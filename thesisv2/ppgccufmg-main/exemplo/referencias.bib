@Article{Garg2022,
author={Garg, Hitendra
and Gupta, Neeraj
and Agrawal, Rohit
and Shivani, Shivendra
and Sharma, Bhisham},
title={A real time cloud-based framework for glaucoma screening using EfficientNet},
journal={Multimedia Tools and Applications},
year={2022},
month={Oct},
day={01},
volume={81},
number={24},
pages={34737-34758},
abstract={These days one of the major causes of partial or complete blindness that has affected a majority of people all around the world is glaucoma. Glaucoma is caused as a result of increased fluid pressure inside the optic nerves called intra ocular pressure. A real time cloud-based framework for screening the glaucoma suspect's retinal fundus images as received by the people on the public cloud, is proposed in this paper. In the proposed framework the existence of glaucoma and analysis of the retinal fundus images is achieved by deep learning technique and convolutional neural network respectively. EfficientNet and UNet++ models are used to identify the presence of glaucoma. On comparing our framework to various state-of-the-art models and quantitative assessment are performing on various benchmark datasets like RIM-ONE and DRISHTI-GS1, it was found that the proposed framework is scalable, location independent, and easily accessible to one and all due to the cloud platform.},
issn={1573-7721},
doi={10.1007/s11042-021-11559-8},
url={https://doi.org/10.1007/s11042-021-11559-8}
}

