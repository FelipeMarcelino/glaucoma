    "        {\n",
    "            \"features\": [features_name[i] for i in feature_order][::-1],\n",
    "            \"importance\": [\n",
    "                np.mean(np.abs(shap_values), axis=0)[i] for i in feature_order\n",
    "            ][::-1],\n",
    "        }\n",
    "    )"
